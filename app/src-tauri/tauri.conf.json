{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kioku",
  "version": "0.2.0",
  "identifier": "app.kioku.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kioku",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: http://127.0.0.1:8765; media-src 'self' http://127.0.0.1:8765; connect-src ipc: http://ipc.localhost http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "Kioku Local Signing", "entitlements": "Entitlements.plist" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
